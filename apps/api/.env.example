# Copy to .env for local development (never commit real secrets)
PORT=4000
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=amazon.nova-micro-v1:0
# Optional: increases GitHub API rate limit from 60/hr to 5,000/hr
GITHUB_TOKEN=
# Comma-separated list of allowed browser origins. Default: * (public read-only API, no cookies)
ALLOWED_ORIGINS=*
# Local UI development only: allow a deterministic non-AI fallback when Bedrock is
# unreachable. NEVER enable in production — demo output must come from Bedrock.
ENABLE_HEURISTIC_FALLBACK=false
